# Copy to .env.local and fill in from your Supabase project (Settings → API).
# Replace the example values below — literal "your_project_url" will break auth (magic link shows an error).
# After changing these, restart `npm run dev` so Next.js inlines the new values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Legacy anon JWT (eyJ…) or newer publishable key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_long_jwt_anon_key_from_dashboard
# Magic link / OAuth: Supabase → Authentication → URL Configuration → Redirect URLs
# must include e.g. http://localhost:3000/auth/callback and your production /auth/callback

# Server-only: never expose in client bundles. Used by API routes (entitlement, webhooks, admin).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: allow POST /api/debug/grant-admin on preview/staging (sets public.users.is_admin).
# Never enable on public production unless the /debug route is removed or protected.
# ALLOW_ADMIN_DEBUG_GRANT=1

# Stripe (server): checkout + webhook verification
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (Dashboard → Products) — used by checkout, restore, and webhooks
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_LIFETIME=price_...
# Alternate names used by subscription flows
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_LIFETIME_PRICE_ID=price_...

# V2: one-time 60-day program checkout (AUD $19 launch — set in Stripe Dashboard)
STRIPE_V2_PROGRAM_PRICE_ID=price_...
# Optional fallback if server env not set (prefer STRIPE_V2_PROGRAM_PRICE_ID on Vercel)
NEXT_PUBLIC_V2_PROGRAM_PRICE_ID=price_...

# Public site origin (https in production, no trailing slash). Used for OAuth/magic-link
# redirects and auth callback URLs. Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: alternate public URL name. Used for Stripe return links if set.
# Magic-link / OAuth prefer NEXT_PUBLIC_SITE_URL when set.
NEXT_PUBLIC_APP_URL=https://your-deployment.example

# Resend (transactional + lifecycle emails)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=hello@monkmodeapp.com

# Sentry (crash reporting + traces)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_ORG=your_org_slug
SENTRY_PROJECT=monkmode

# PostHog (product analytics)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
