# Copy to .env.local and fill in from your Supabase project (Settings → API).
# Replace the example values below — literal "your_project_url" will break auth (magic link shows an error).
# After changing these, restart `npm run dev` so Next.js inlines the new values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Legacy anon JWT (eyJ…) or newer publishable key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_long_jwt_anon_key_from_dashboard
# Magic link / OAuth: Supabase → Authentication → URL Configuration → Redirect URLs
# must include e.g. http://127.0.0.1:3000/auth/callback and your production /auth/callback

# Server-only: never expose in client bundles. Used by API routes (entitlement, webhooks, admin).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe (server): checkout + webhook verification
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (Dashboard → Products) — used by checkout, restore, and webhooks
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_LIFETIME=price_...
# Alternate names used by subscription flows
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_LIFETIME_PRICE_ID=price_...

# Optional: canonical public URL for Stripe return links (portal). Falls back to request host.
NEXT_PUBLIC_APP_URL=https://your-deployment.example

# Resend (transactional + lifecycle emails)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=hello@monkmodeapp.com

# Sentry (crash reporting + traces)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_ORG=your_org_slug
SENTRY_PROJECT=monkmode

# PostHog (product analytics)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
