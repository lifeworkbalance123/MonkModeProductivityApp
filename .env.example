# Copy to .env.local and fill in from your Supabase project (Settings → API).
# After changing these, restart `npm run dev` so Next.js inlines the new values.
NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Magic link / OAuth: Supabase → Authentication → URL Configuration → Redirect URLs
# must include e.g. http://127.0.0.1:3000/auth/callback and your production /auth/callback

# Server-only: never expose in client bundles. Used by API routes (entitlement, webhooks, admin).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe (server): checkout + webhook verification
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (Dashboard → Products) — used by restore-purchases and webhooks
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_LIFETIME=price_...

# Optional: canonical public URL for Stripe return links (portal). Falls back to request host.
NEXT_PUBLIC_APP_URL=https://your-deployment.example
