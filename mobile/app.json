{
  "expo": {
    "name": "monkcubed",
    "slug": "monkmode-productivity",
    "version": "1.0.0",
    "scheme": "monkmode",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.monkmode.productivity",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.monkmode.shared"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111827"
      },
      "package": "com.monkmode.productivity"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Monk Mode to attach training images."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "react-native-widget-extension",
        {
          "targetName": "MonkModeWidget",
          "src": "./ios/MonkModeWidget"
        }
      ]
    ]
  }
}
